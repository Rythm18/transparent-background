+# -------------- URL helpers and loaders --------------
+
+def is_url(value: str) -> bool:
+    return isinstance(value, str) and value.startswith(("http://", "https://"))
+
+
+def get_format_from_url(url: str, content_type: str = None) -> str:
+    try:
+        path = urlparse(url).path
+    except Exception:
+        path = url
+    lower = path.lower()
+    if any(lower.endswith(f".{ext}") for ext in IMG_EXTS):
+        return "Image"
+    if any(lower.endswith(f".{ext}") for ext in VID_EXTS):
+        return "Video"
+    if content_type:
+        if content_type.startswith("image/"):
+            return "Image"
+        if content_type.startswith("video/"):
+            return "Video"
+    return ""
+
+
+def _infer_suffix(url: str, content_type: str = None) -> str:
+    try:
+        path = urlparse(url).path
+    except Exception:
+        path = url
+    base, ext = os.path.splitext(path)
+    if ext and len(ext) <= 5:
+        return ext
+    if content_type:
+        guess = mimetypes.guess_extension(content_type.split(";")[0].strip())
+        if guess:
+            return guess
+    return ""
+
+
+def _call_with_retries(func, *, retries, backoff_base=_BACKOFF_BASE, timeout=None, **kwargs):
+    if requests is None:
+        raise RuntimeError("requests is required for remote input support")
+    attempts = max(1, retries)
+    last_exc = None
+    for attempt in range(1, attempts + 1):
+        try:
+            logger.debug("download attempt %d/%d", attempt, attempts)
+            return func(timeout=timeout, **kwargs)
+        except requests.RequestException as exc:
+            last_exc = exc
+            if attempt == attempts:
+                raise
+            sleep_for = min(_BACKOFF_CAP, backoff_base * (2 ** (attempt - 1)))
+            time.sleep(sleep_for)
+    raise last_exc  # pragma: no cover - loop always returns/raises
+
+
+def download_url_to_tempfile(url: str, suffix: str = None, timeout: float = _DEFAULT_VIDEO_TIMEOUT, retries: int = _DEFAULT_RETRIES) -> str:
+    assert requests is not None, "requests dependency missing"
+
+    head_ct = None
+    try:
+        head_resp = requests.head(url, timeout=min(timeout, 10.0))
+        head_resp.raise_for_status()
+        head_ct = head_resp.headers.get("content-type")
+    except requests.RequestException:
+        head_ct = None
+
+    if suffix is None:
+        suffix = _infer_suffix(url, head_ct)
+    if suffix and not suffix.startswith('.'):
+        suffix = f".{suffix}"
+
+    temp_path = None
+    try:
+        with tempfile.NamedTemporaryFile(delete=False, suffix=suffix or None) as tf:
+            temp_path = tf.name
+
+        def _get(**kwargs):
+            return requests.get(url, stream=True, **kwargs)
+
+        with _call_with_retries(_get, retries=retries, timeout=timeout) as response:
+            response.raise_for_status()
+            with open(temp_path, 'wb') as out_f:
+                for chunk in response.iter_content(chunk_size=8192):
+                    if chunk:
+                        out_f.write(chunk)
+        return temp_path
+    except Exception:
+        if temp_path and os.path.exists(temp_path):
+            os.remove(temp_path)
+        raise
+
+
+def fetch_image_from_url(url: str, timeout: float = _DEFAULT_IMAGE_TIMEOUT, retries: int = _DEFAULT_RETRIES) -> Image.Image:
+    assert requests is not None, "requests dependency missing"
+
+    def _get(**kwargs):
+        return requests.get(url, stream=False, **kwargs)
+
+    response = _call_with_retries(_get, retries=retries, timeout=timeout)
+    response.raise_for_status()
+    return Image.open(BytesIO(response.content)).convert('RGB')
+
