+            delay = min(_BACKOFF_BASE * (2 ** (attempt - 1)), _BACKOFF_CAP)
+            logger.debug("Retrying download attempt %d/%d after error: %s", attempt, attempts, exc)
+            sleep_fn(delay)
+    assert last_error is not None
+    raise last_error
