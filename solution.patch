+class URLImageLoader:
+    def __init__(self, url: str, *, timeout: float = _DEFAULT_IMAGE_TIMEOUT, retries: int = _DEFAULT_RETRIES):
+        self.url = url
+        self.timeout = timeout
+        self.retries = retries
+        self.image = fetch_image_from_url(url, timeout=timeout, retries=retries)
+        try:
+            path = urlparse(url).path
+        except Exception:
+            path = url
+        name = os.path.basename(path)
+        if not name:
+            name = "remote.jpg"
+        self.name = name
+        self.size = 1
+
+    def __iter__(self):
+        self.index = 0
+        return self
+
+    def __next__(self):
+        if self.index >= self.size:
+            raise StopIteration
+        self.index += 1
+        return self.image, self.name
+
+    def __len__(self):
+        return self.size
+
+
+class URLVideoLoader:
